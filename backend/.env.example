PORT=3000
# Email/password signups require verification in every environment.
# Configure SMTP below; ALLOW_DEV_LINKS=1 permits local testing without SMTP.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=fitnessapp
JWT_SECRET=replace-with-random-64-hex-chars-min-32-not-the-example-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
# Third fallback leg. Free image-input models only by default — never billed.
# BACKEND ONLY: never expose this as VITE_* (that would ship it to the browser).
OPENROUTER_API_KEY=
# Optional model overrides (comma-separated, tried in order). Defaults are the
# flash-lite Gemini models verified live (2–4s); 3.6/3.7/3.8-flash currently
# 503 or hang, so they are NOT in the default list.
# GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Groq text + vision fallback (vision uses a compact prompt to fit 7k ITPM).
# GROQ_TEXT_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODELS=qwen/qwen3.8-27b
# OpenRouter free models (:free suffix is required). First usable one wins.
# OPENROUTER_VISION_MODELS=inclusionai/ling-3.2-flash:free,nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_TEXT_MODELS=inclusionai/ling-3.2-flash:free,google/gemma-4-31b-it:free
# Per-provider AI timeouts in ms (defaults: text/vision 15000, OpenRouter 20000)
# AI_VISION_TIMEOUT_MS=15000
# AI_GROQ_VISION_TIMEOUT_MS=15000
# AI_OPENROUTER_TIMEOUT_MS=20000
# Chain-wide vision budget: Gemini leg first, then Groq + OpenRouter.
# AI_VISION_BUDGET_MS=75000
# AI_VISION_GEMINI_BUDGET_MS=40000
# Keep DB + app on the same timezone (UTC recommended) — aiQuota UTC_DATE(),
# daily_stats stat_date, and readiness TODAY must agree on day boundaries.
# TZ=UTC
# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Provider: BREVO (transactional SMTP relay). Get these from
# Brevo → SMTP & API → SMTP tab. Leave blank to disable email gracefully.
# Recommended on Render: HTTPS API (works without SMTP ports).
# Brevo → SMTP & API → API keys & MCP. This is NOT the SMTP key.
BREVO_API_KEY=
# Delivery status webhook: use a random secret, also configured as Bearer
# authentication in Brevo. See docs/EMAIL_DELIVERY.md.
BREVO_WEBHOOK_SECRET=
# Required with BREVO_API_KEY; must be a verified sender in Brevo.
MAIL_FROM=
# Optional SMTP fallback, used only when BREVO_API_KEY is absent.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Optional overrides (defaults shown)
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# From address/name shown to recipients (defaults: BREVO_SMTP_LOGIN / "Vitalis")
# MAIL_FROM=
MAIL_FROM_NAME=Vitalis
# Legacy Gmail fallback — only used if BREVO_* above are unset.
EMAIL_USER=
EMAIL_PASS=
# Inbox for public POST /api/feedback (rate-limited, no auth by design)
RECEIVER_EMAIL=
# Production: replace with your deployed frontend HTTPS URL for email links.
FRONTEND_URL=http://localhost:5173
# DANGER: =1 exposes verify/reset links in API responses. Never enable in production.
ALLOW_DEV_LINKS=0
# Set to 1 only for local dev behind a MITM proxy; never in production
# MAILER_INSECURE_TLS=0
# Scale tuning (same defaults as code — no behavior change unless set)
# DB_POOL_MAX=25
# DB_QUEUE_LIMIT=200
# GLOBAL_RATE_LIMIT=1000
# AI_DAILY_LIMIT=50
# Managed MySQL TLS (Aiven): TLS turns on automatically when NODE_ENV=production
# or DB_HOST ends in .aivencloud.com / .aiven.io. DB_SSL=1 forces it on anywhere,
# DB_SSL=0 forces it off. DB_SSL_CA takes a path to ca.pem or the raw PEM inline
# (how deploy secrets are injected); production fails fast if it is missing.
# DB_SSL=
# DB_SSL_CA=
# Regex allowlist for preview deployments (e.g. ^https:\/\/preview-.*\.example\.com$)
# ALLOWED_ORIGIN_REGEX=
# Dedicated salt for landing visit ip_hash (optional — falls back to JWT_SECRET slice for old hashes)
# IP_HASH_SALT=replace-with-random-32-char-string
# Socket auth re-verify interval in ms (see src/sockets/socketHandler.js)
# SOCKET_REVERIFY_MS=
# Verbose request logging (see src/middleware/requestLogger.js)
# DEBUG=0

# SMS verification (UniSMS) - backend only. Never expose these to the frontend.
# Secret key goes in UNISMS_SECRET_KEY (used as the HTTP Basic username).
# Sender ID defaults to Unisoft; change it here if UniSMS issues a new one.
# UNISMS_MOCK=1 makes every send a no-op (no credits, no network) - use it in
# development and tests. Leave UNISMS_MOCK unset in production.
# UNISMS_SECRET_KEY=
# UNISMS_SENDER_ID=Unisoft
# UNISMS_MOCK=0
# UNISMS_TIMEOUT_MS=10000
# Opt development into the real SMS flow (registration needs the code).
# Keep it unset for the usual dev auto-verify shortcut.
# SMS_VERIFY_DEV=0
