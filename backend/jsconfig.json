{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "checkJs": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": false
  },
  "include": ["server.js", "start-prod.js", "src/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules"]
}
