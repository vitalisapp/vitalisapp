{
  "name": "backend",
  "version": "1.0.0",
  "description": "Vitalis backend — Express + MySQL + Socket.io API",
  "main": "server.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:list": "node scripts/run-tests.js --list",
    "test:jest": "node scripts/run-tests.js --jest-only",
    "test:node": "node scripts/run-tests.js --node-only",
    "test:api": "node scripts/run-tests.js --suite api",
    "test:auth": "node scripts/run-tests.js --suite auth",
    "test:authorization": "node scripts/run-tests.js --suite authorization",
    "test:security": "node scripts/run-tests.js --suite security",
    "test:db": "node scripts/run-tests.js --suite db",
    "test:external": "node scripts/run-tests.js --suite external",
    "test:modules": "node scripts/run-tests.js --suite modules",
    "test:unit": "node scripts/run-tests.js --suite unit",
    "test:integration": "node scripts/run-tests.js --suite integration",
    "test:smoke": "node scripts/run-tests.js --suite smoke",
    "test:coverage": "node scripts/run-tests.js --suite coverage",
    "test:node:unit": "node scripts/run-tests.js --node-only --suite unit",
    "test:node:integration": "node scripts/run-tests.js --node-only --suite integration",
    "test:watch": "jest --watch",
    "test:failed": "jest --runInBand --onlyFailures",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:endpoints:generate": "node scripts/generate-endpoint-manifest.js",
    "test:endpoints:check": "node scripts/generate-endpoint-manifest.js --check",
    "lint": "node scripts/check-syntax.js",
    "start": "node server.js",
    "start:prod": "node start-prod.js",
    "dev": "node --watch server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:dry": "node src/db/migrate.js --dry-run",
    "db:status": "node src/db/migrate.js --dry-run",
    "db:create": "node src/db/create-migration.js",
    "db:sql": "node scripts/build-database-sql.js",
    "seed:plans": "node src/db/migrate.js --seed-plans",
    "foods:images": "node scripts/fillFoodImages.js",
    "eval:filipino": "node scripts/eval-filipino-scans.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "fitness",
    "express",
    "mysql"
  ],
  "author": "Vitalis",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@openrouter/sdk": "^1.5.116",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.6.2",
    "groq-sdk": "^1.1.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.7",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "ua-parser-js": "^2.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "supertest": "^6.3.4"
  }
}
