# Empty = same-origin via Vite dev proxy (recommended for local + tunnel demos).
# Absolute backend URL only needed for setups without the dev proxy.
# PRODUCTION static builds MUST set absolute https URLs, e.g.:
# VITE_API_URL=https://api.example.com
# VITE_SOCKET_URL=https://api.example.com
VITE_API_URL=
VITE_SOCKET_URL=
VITE_GOOGLE_CLIENT_ID=
# Dev-proxy overrides (vite.config.js only, never shipped to build):
# BACKEND_URL=http://localhost:3000
# VITE_HMR_CLIENT_PORT=443 (only behind TLS-terminating tunnels)
