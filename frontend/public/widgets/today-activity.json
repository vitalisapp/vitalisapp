{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "TODAY'S ACTIVITY", "size": "Small", "weight": "Bolder", "isSubtle": true, "wrap": true },
            { "type": "TextBlock", "$when": "${state == 'ready' || state == 'empty'}", "text": "${dateLabel}", "size": "Small", "isSubtle": true, "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "$when": "${state == 'ready'}",
          "items": [
            { "type": "TextBlock", "text": "${pctLabel}", "weight": "Bolder", "color": "Accent" }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'ready'}",
      "spacing": "Small",
      "items": [
        { "type": "TextBlock", "text": "${steps}", "size": "ExtraLarge", "weight": "Bolder" },
        { "type": "TextBlock", "text": "steps logged · goal ${stepGoal}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            { "type": "Column", "width": "${pctWeight}", "style": "good", "minHeight": "6px", "items": [] },
            { "type": "Column", "width": "${restWeight}", "style": "emphasis", "minHeight": "6px", "spacing": "None", "items": [] }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "KCAL", "size": "Small", "isSubtle": true },
                { "type": "TextBlock", "text": "${calories}", "weight": "Bolder", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "ACTIVE", "size": "Small", "isSubtle": true },
                { "type": "TextBlock", "text": "${minutes}", "weight": "Bolder", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "STREAK", "size": "Small", "isSubtle": true },
                { "type": "TextBlock", "text": "${streak}", "weight": "Bolder", "spacing": "None" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'empty'}",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "No activity logged today", "weight": "Bolder", "wrap": true },
        { "type": "TextBlock", "text": "Log a workout or your daily steps in VITALIS to fill this widget.", "size": "Small", "isSubtle": true, "wrap": true }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'signedout'}",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "Sign in to VITALIS", "weight": "Bolder", "wrap": true },
        { "type": "TextBlock", "text": "Open the app and sign in to see today's activity here.", "size": "Small", "isSubtle": true, "wrap": true }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'loading'}",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "Loading your activity…", "weight": "Bolder", "wrap": true },
        { "type": "TextBlock", "text": "Your real VITALIS numbers appear here in a moment.", "size": "Small", "isSubtle": true, "wrap": true }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'error'}",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "Couldn't refresh", "weight": "Bolder", "wrap": true },
        { "type": "TextBlock", "text": "Check your connection. VITALIS will try again shortly.", "size": "Small", "isSubtle": true, "wrap": true }
      ]
    },
    { "type": "TextBlock", "text": "${updatedLabel}", "size": "Small", "isSubtle": true, "spacing": "Medium" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "${actionTitle}", "verb": "${actionVerb}" }
  ]
}
